<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.klausbernt.icloud_evict</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/klausbernt/System_Hygiene/iCloudCleanUpCenter/scripts/icloud_evict.sh</string>
    <string>90</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ICLOUD_EVICT_ENABLE</key>
    <string>0</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/klausbernt/icloud-reports/launchd-icloud_evict.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/klausbernt/icloud-reports/launchd-icloud_evict.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
